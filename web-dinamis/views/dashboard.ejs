<%- include('partials/head') %>
  <main class="mobile-shell with-nav">
    <header class="app-header">
      <div>
        <small>Dashboard</small>
        <h1>Halo, <%= user.name.split(' ')[0] %></h1>
    </div>
    <a class="mini-button" href="/profil">
      <span class="material-symbols-rounded">person</span>
      Profil
    </a>
  </header>
  <%- include(' partials/flash') %>

            <section class="quick-chat-card">
              <div class="quick-chat-top">
                <div>
                  <h2>Catat transaksi cepat</h2>
                  <p>Ketik natural seperti <span class="inline-pill">beli kopi 25rb</span>.</p>
                </div>
                <span class="feature-icon material-symbols-rounded">auto_awesome</span>
              </div>
              <form method="POST" action="/chat" class="chat-input-form">
                <input type="hidden" name="redirectTo" value="/dashboard" />
                <input type="text" name="message" placeholder="beli kopi 25rb" required />
                <button type="submit">
                  <span class="material-symbols-rounded">send</span>
                  Kirim
                </button>
              </form>
              <div class="chat-chips left">
                <a href="/input-chat?text=beli%20kopi%2025rb">Demo parse</a>
                <a href="/input-chat?text=sisa%20budget%20makan%20berapa">Cek budget</a>
                <a href="/input-chat?text=bulan%20ini%20paling%20boros%20apa">Tanya insight</a>
              </div>
            </section>

            <div class="dashboard-grid">
              <div>
                <section class="summary-card">
                  <div class="summary-top">
                    <span>Saldo bulan ini</span>
                    <form method="GET" action="/dashboard">
                      <input type="month" name="month" value="<%= data.month %>" onchange="this.form.submit()" />
                    </form>
                  </div>
                  <h2>
                    <%= formatRupiah(data.summary.balance) %>
                  </h2>
                  <p>
                    <%= data.monthLabel %>
                  </p>
                  <div class="summary-split">
                    <div>
                      <span class="dot income"></span>
                      <small>Pemasukan</small>
                      <strong>
                        <%= formatRupiah(data.summary.income) %>
                      </strong>
                    </div>
                    <div>
                      <span class="dot expense"></span>
                      <small>Pengeluaran</small>
                      <strong>
                        <%= formatRupiah(data.summary.expense) %>
                      </strong>
                    </div>
                  </div>
                </section>

                <div class="chart-grid">
                  <section class="chart-card">
                    <div class="section-title">
                      <h2>Pengeluaran kategori</h2>
                      <small>
                        <%= data.monthLabel %>
                      </small>
                    </div>
                    <canvas id="categoryChart"></canvas>
                  </section>
                  <section class="chart-card">
                    <div class="section-title">
                      <h2>Masuk vs Keluar</h2>
                      <small>
                        <%= data.monthLabel %>
                      </small>
                    </div>
                    <canvas id="cashflowChart"></canvas>
                  </section>
                </div>

                <section class="section-block">
                  <div class="section-title">
                    <h2>Kategori pengeluaran</h2>
                    <small>
                      <%= data.monthLabel %>
                    </small>
                  </div>
                  <% if (data.categoryStats.length===0) { %>
                    <div class="empty-card">Belum ada pengeluaran di bulan ini.</div>
                    <% } else { %>
                      <% data.categoryStats.forEach((item)=> {
                        const percent = data.summary.expense ? Math.round((Number(item.total) / data.summary.expense) *
                        100) : 0;
                        %>
                        <div class="stat-row">
                          <div>
                            <strong>
                              <%= item.name %>
                            </strong>
                            <small>
                              <%= percent %>% dari pengeluaran
                            </small>
                          </div>
                          <span>
                            <%= formatRupiah(item.total) %>
                          </span>
                        </div>
                        <% }) %>
                          <% } %>
                </section>
              </div>

              <aside>
                <section class="section-block">
                  <div class="section-title">
                    <h2>Insight FinChat</h2>
                    <a href="/budget">Lihat budget</a>
                  </div>
                  <% data.insights.forEach((insight)=> { %>
                    <article class="insight-card <%= insight.tone %>">
                      <strong>
                        <%= insight.title %>
                      </strong>
                      <p>
                        <%= insight.message %>
                      </p>
                    </article>
                    <% }) %>
                </section>

                <section class="section-block">
                  <div class="section-title">
                    <h2>Transaksi terbaru</h2>
                    <a href="/riwayat">Lihat semua</a>
                  </div>
                  <% if (data.recentTransactions.length===0) { %>
                    <div class="empty-card">Belum ada transaksi.</div>
                    <% } %>
                      <% data.recentTransactions.forEach((trx)=> { %>
                        <div class="transaction-row">
                          <div class="transaction-icon material-symbols-rounded">
                            <%= trx.type==='income' ? 'add' : 'remove' %>
                          </div>
                          <div class="transaction-main">
                            <strong>
                              <%= trx.description %>
                            </strong>
                            <small>
                              <%= trx.category_name %> • <%= formatDateShortID(trx.transaction_date) %>
                            </small>
                          </div>
                          <span class="amount <%= trx.type %>">
                            <%= trx.type==='income' ? '+' : '-' %>
                              <%= formatRupiah(trx.amount) %>
                          </span>
                        </div>
                        <% }) %>
                </section>
              </aside>
            </div>

            <a class="fab material-symbols-rounded" href="/input-chat">add</a>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const categoryLabels = <% - JSON.stringify(data.categoryStats.map((item) => item.name)) %>;
    const categoryValues = <% - JSON.stringify(data.categoryStats.map((item) => Number(item.total || 0))) %>;
    const incomeValue = <%= Number(data.summary.income || 0) %>;
    const expenseValue = <%= Number(data.summary.expense || 0) %>;

    const commonOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: '#cfe2d3', boxWidth: 12, font: { family: 'Inter' } } }
      },
      scales: {
        x: { ticks: { color: '#9eb0a4' }, grid: { color: 'rgba(206,245,214,.08)' } },
        y: { ticks: { color: '#9eb0a4' }, grid: { color: 'rgba(206,245,214,.08)' } }
      }
    };

    const categoryCtx = document.getElementById('categoryChart');
    if (categoryCtx) {
      new Chart(categoryCtx, {
        type: 'doughnut',
        data: {
          labels: categoryLabels.length ? categoryLabels : ['Belum ada data'],
          datasets: [{
            data: categoryValues.length ? categoryValues : [1],
            backgroundColor: ['#43e57b', '#60a5fa', '#fbbf24', '#a78bfa', '#fb7185', '#34d399'],
            borderColor: 'rgba(7,17,11,.9)',
            borderWidth: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          plugins: {
            legend: { position: 'bottom', labels: { color: '#cfe2d3', boxWidth: 12, font: { family: 'Inter' } } }
          }
        }
      });
    }

    const cashflowCtx = document.getElementById('cashflowChart');
    if (cashflowCtx) {
      new Chart(cashflowCtx, {
        type: 'bar',
        data: {
          labels: ['Pemasukan', 'Pengeluaran'],
          datasets: [{
            label: 'Nominal',
            data: [incomeValue, expenseValue],
            backgroundColor: ['#43e57b', '#fb7185'],
            borderRadius: 14
          }]
        },
        options: commonOptions
      });
    }
  </script>
  <%- include('partials/bottom-nav') %>
    <%- include('partials/end') %>