<%- include('partials/head') %>
<main class="mobile-shell with-nav">
  <header class="app-header">
    <div>
      <small>Transaksi</small>
      <h1>Input Manual</h1>
    </div>
    <a class="mini-button" href="/input-chat">Via Chat</a>
  </header>
  <%- include('partials/flash') %>

  <section class="form-card">
    <form method="POST" action="/input-manual" class="form-stack">
      <label>Jenis transaksi
        <select name="type" required>
          <option value="expense">Pengeluaran</option>
          <option value="income">Pemasukan</option>
        </select>
      </label>
      <label>Nominal
        <input type="number" name="amount" placeholder="25000" required />
      </label>
      <div class="quick-amounts" aria-label="Nominal cepat">
        <button type="button" data-amount="10000">10rb</button>
        <button type="button" data-amount="25000">25rb</button>
        <button type="button" data-amount="50000">50rb</button>
        <button type="button" data-amount="100000">100rb</button>
      </div>
      <label>Kategori
        <select name="categoryId" required>
          <% categories.forEach((category) => { %>
            <option value="<%= category.id %>"><%= category.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Tanggal
        <input type="date" name="transactionDate" value="<%= today %>" required />
      </label>
      <label>Catatan
        <input type="text" name="description" placeholder="Kopi susu" required />
      </label>
      <button class="button button-primary full" type="submit">Simpan Transaksi</button>
    </form>
  </section>
</main>
<script>
  document.querySelectorAll('[data-amount]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelector('input[name="amount"]').value = button.dataset.amount;
    });
  });
</script>
<%- include('partials/bottom-nav') %>
<%- include('partials/end') %>
