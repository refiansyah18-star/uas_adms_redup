<%- include('partials/head') %>
  <main class="onboarding-shell">
    <section class="onboarding-panel">
      <div class="eyebrow">Onboarding</div>
      <h1>Mulai dari satu transaksi.</h1>
      <p>FinChat akan membaca input bahasa natural, menyiapkan preview, lalu menyimpan transaksi ke database.</p>

      <div class="onboarding-steps">
        <div class="onboarding-step">
          <span class="step-number">1</span>
          <div>
            <strong>Tulis transaksi</strong>
            <p>Contoh: “tadi beli kopi 25rb”.</p>
          </div>
        </div>
        <div class="onboarding-step">
          <span class="step-number">2</span>
          <div>
            <strong>Parser membaca data</strong>
            <p>Nominal, kategori, tipe, dan tanggal dideteksi otomatis.</p>
          </div>
        </div>
        <div class="onboarding-step">
          <span class="step-number">3</span>
          <div>
            <strong>Dashboard langsung update</strong>
            <p>Data tersimpan ke MariaDB dan muncul di ringkasan bulanan.</p>
          </div>
        </div>
      </div>

      <a class="text-link" href="/dashboard">Lewati dan masuk dashboard</a>
    </section>

    <section class="onboarding-preview">
      <%- include('partials/flash') %>
        <div class="chat-header">
          <div class="bot-avatar material-symbols-rounded">auto_awesome</div>
          <div>
            <strong>Transaksi pertama</strong>
            <small>Coba pakai contoh di bawah ini</small>
          </div>
        </div>

        <form method="POST" action="/onboarding" class="form-stack">
          <label>Input chat
            <input type="text" name="message" placeholder="beli kopi 25rb" required autofocus />
          </label>
          <button class="button button-primary full" type="submit">
            <span class="material-symbols-rounded">send</span>
            Simpan transaksi pertama
          </button>
        </form>

        <div class="chat-chips left">
          <span>bayar kos 800rb</span>
          <span>dapat transfer 500rb</span>
          <span>makan ayam geprek 18000</span>
        </div>

        <div class="hero-demo-card" style="margin-top:22px; box-shadow:none">
          <div class="detect-title">Preview hasil parser</div>
          <div class="parsed-grid">
            <span>Nominal</span><strong>Rp 25.000</strong>
            <span>Kategori</span><strong>Makanan & Minuman</strong>
            <span>Status</span><strong>Siap disimpan</strong>
          </div>
        </div>
    </section>
  </main>
  <%- include('partials/end') %>