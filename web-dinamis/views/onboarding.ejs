<%- include('partials/head') %>
<main class="mobile-shell center-shell">
  <%- include('partials/flash') %>
  <section class="onboarding-card">
    <div class="brand-icon large">◈</div>
    <h1>Catat transaksi pertamamu</h1>
    <p>Coba tulis transaksi seperti bahasa sehari-hari. Contoh: “beli kopi 25rb”.</p>
    <form method="POST" action="/onboarding" class="chat-input-form">
      <input type="text" name="message" placeholder="beli kopi 25rb" required autofocus />
      <button class="button button-primary" type="submit">Simpan</button>
    </form>
    <div class="chat-chips left">
      <span>bayar kos 800rb</span>
      <span>dapat transfer 500rb</span>
      <span>makan ayam geprek 18000</span>
    </div>
    <a class="text-link" href="/dashboard">Lewati dulu</a>
  </section>
</main>
<%- include('partials/end') %>
